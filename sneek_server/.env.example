# Copy to .env and adjust. Defaults match the demo client_id spotify_123.

PORT=4000
# Browser origins allowed to call the API (Access-Control-Allow-Origin). Comma-separated.
# Include your verifier UI, e.g. https://mobile.sneek.in and http://localhost:3030 for dev.
CORS_ORIGIN=http://localhost:3030

# Empty = origin gate is skipped (easiest for demos). To enforce browser Origin:
# CLIENT_ALLOWED_ORIGINS=http://localhost:3030,https://mobile.sneek.in
# If allowlist is set, curl/native clients without Origin need:
# ALLOW_SCAN_WITHOUT_ORIGIN=true

# Must match the client backend that mints the QR (same client_id / K1 / kid / callback secret).
CLIENT_ID=spotify_123
CLIENT_KID=spotify.com
CLIENT_K1=secretkey
CALLBACK_SECRET=spotify-callback-secret
CLIENT_NAME=Spotify

# Where Sneek POSTs verify-session, verification-sync, and callback (omit to skip client bridge — gates still pass).
# CLIENT_SERVER_URL=https://md.sneek.in
