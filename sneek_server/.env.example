# Copy to .env and adjust. Defaults match the demo client_id spotify_123.

PORT=4000

# CORS: browsers may only read responses if their Origin is listed (comma-separated).
# Must include every host that serves the verifier UI (matches Origin header).
CORS_ORIGIN=http://localhost:3030,https://mobile.sneek.in

# Origin gate: SAME hostnames as verifier UI (comma-separated, no trailing slashes).
# With this set, verification.origin becomes "passed" or "failed" (never "skipped") for browser calls.
# Sneek normalizes trailing slashes; Origin must match exactly as sent by the browser.
CLIENT_ALLOWED_ORIGINS=http://localhost:3030,https://mobile.sneek.in

# Non-browser callers (curl, some native HTTP) send no Origin → 403 unless you allow:
# ALLOW_SCAN_WITHOUT_ORIGIN=true

# ── For “all Sneek gates passed” in one /sneek/scan response ─────────────────
# 1) CLIENT_ALLOWED_ORIGINS + matching CORS (above) so origin is "passed" from the verifier UI.
# 2) CLIENT_ID / CLIENT_K1 / CLIENT_KID / CALLBACK_SECRET match the app that minted the QR blob.
# 3) mobileToken in the request body must equal Sneek’s expected token (demo: demo-mobile-token).
# 4) Blob not expired and not replayed.
# 5) If CLIENT_SERVER_URL is set below, that backend must accept verify-session + verify the
#    signed callback — otherwise callbackSignature and related gates fail.
# 6) Omit CLIENT_SERVER_URL only for isolated Sneek demos (bridge steps skipped; gates still pass).

# Must match the client backend that mints the QR (same client_id / K1 / kid / callback secret).
CLIENT_ID=spotify_123
CLIENT_KID=spotify.com
CLIENT_K1=secretkey
CALLBACK_SECRET=spotify-callback-secret
CLIENT_NAME=Spotify

# POST verify-session, verification-sync, sneek/callback to this base URL (no trailing slash).
# Required for real end-to-end auth; must match the issuer of the session_id in the blob.
# CLIENT_SERVER_URL=https://your-client-api.example.com
